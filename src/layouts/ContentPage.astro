---
// Static, crawlable pages around the game. Same stylesheet stack as the game so bundled CSS keeps its order.
import Seo from '../components/Seo.astro';
import {SITE_NAME, absolute} from '../lib/seo.js';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '../styles/quizo-adapted.css';
import '../styles/global.css';
import '../styles/football-theme.css';
import '../styles/sharing.css';
import '../styles/pages.css';
interface Props {title: string; heading: string; description: string; path: string; jsonLd?: object | object[]; ctaHref?: string; ctaLabel?: string}
// The header button reads “Play” on phones and “Play” + ctaLabel on wider screens.
const {title, heading, description, path, jsonLd, ctaHref = '/', ctaLabel = ' today’s matchday'} = Astro.props;
const breadcrumbs = {'@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  {'@type': 'ListItem', position: 1, name: SITE_NAME, item: absolute('/')},
  {'@type': 'ListItem', position: 2, name: heading, item: absolute(path)},
]};
---
<!doctype html><html lang="en"><head><Seo title={title} description={description} path={path} jsonLd={jsonLd ? [breadcrumbs, ...[jsonLd].flat()] : breadcrumbs}/></head>
<body>
<header class="page-header"><a class="brand" href="/" aria-label="Geo Football home"><span class="brand-mark"><img src="/favicon.svg" alt="" width="40" height="45"/></span><span class="brand-type">GEO<span>FOOTBALL</span></span></a><a class="page-cta" href={ctaHref}>Play<span class="cta-long">{ctaLabel}</span> <span aria-hidden="true">→</span></a></header>
<main class="article">
<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Geo Football</a> / {heading}</nav>
<h1>{heading}</h1>
<slot/>
</main>
<footer class="page-footer"><a href="/">Play the daily quiz</a><a href="/stadium-quiz/">Stadium quiz</a><a href="/footballer-birthplace-quiz/">Footballer birthplace quiz</a><a href="/how-to-play/">How to play</a><a href="/about/">About the questions</a><a href="/data-licenses.txt">Data credits</a></footer>
</body></html>
