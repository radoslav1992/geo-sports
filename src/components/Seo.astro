---
// Shared <head> tags: canonical URL, social previews, icons and structured data.
import {SITE_NAME, absolute} from '../lib/seo.js';
interface Props {title: string; description: string; path: string; noindex?: boolean; jsonLd?: object}
const {title, description, path, noindex = false, jsonLd} = Astro.props;
const url = absolute(path), image = absolute('/og-image.png');
---
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title>
<meta name="description" content={description}/>
{noindex ? <meta name="robots" content="noindex"/> : <link rel="canonical" href={url}/>}
<meta name="theme-color" content="#06101a"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192"/>
<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
<link rel="manifest" href="/site.webmanifest"/>
<meta property="og:type" content="website"/>
<meta property="og:site_name" content={SITE_NAME}/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:url" content={url}/>
<meta property="og:image" content={image}/>
<meta property="og:image:width" content="1200"/>
<meta property="og:image:height" content="630"/>
<meta property="og:image:alt" content="Geo Football: pin football history on a world map laid over a floodlit pitch."/>
<meta property="og:locale" content="en_GB"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content={title}/>
<meta name="twitter:description" content={description}/>
<meta name="twitter:image" content={image}/>
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}/>}
