---
import {questions} from '../data/questions.js';
import {DAILY_REPEAT_DAYS} from '../lib/game.js';
import Sharing from '../components/Sharing.astro';
import Pitch from '../components/Pitch.astro';
import WorldMap from '../components/WorldMap.astro';
import Seo from '../components/Seo.astro';
import Byline from '../components/Byline.astro';
import {SITE, SITE_NAME, LAUNCH_DATE, PUBLISHER, absolute} from '../lib/seo.js';
import {homeFaq} from '../data/faq.js';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '../styles/quizo-adapted.css';
import '../styles/global.css';
import '../styles/football-theme.css';
import '../styles/sharing.css';
import '../styles/pages.css';
const total = questions.length.toLocaleString('en-US'), nations = new Set(questions.map(q => q.country)).size;
const title = 'Geo Football – Daily Football Geography Quiz';
const description = `Five football clues a day: pin famous stadiums, legends’ birthplaces and World Cup moments on the world map. Free, no sign-up, ${total} questions.`;
const game = {'@type': ['WebApplication', 'VideoGame'], '@id': `${SITE}/#game`, name: SITE_NAME, url: absolute('/'), description,
  applicationCategory: 'GameApplication', genre: ['Trivia', 'Geography', 'Football'], operatingSystem: 'Any (web browser)',
  isAccessibleForFree: true, offers: {'@type': 'Offer', price: '0', priceCurrency: 'USD'}, inLanguage: 'en', image: absolute('/og-image.png'),
  playMode: 'SinglePlayer', datePublished: LAUNCH_DATE, author: {'@id': PUBLISHER['@id']}, publisher: {'@id': PUBLISHER['@id']}, isPartOf: {'@id': `${SITE}/#website`}};
---
<!doctype html><html lang="en"><head><Seo title={title} description={description} path="/" faq={homeFaq} jsonLd={[game]}/></head>
<body>
<header class="site-header"><h1 class="brand-heading"><a class="brand" href="/" aria-label="Geo Football: daily football geography quiz"><span class="brand-mark"><img src="/favicon.svg" alt="" width="40" height="45"/></span><span class="brand-type">GEO<span>FOOTBALL</span></span></a></h1><span class="header-tagline">THE WORLD IS YOUR HOME GROUND</span><div class="round-toolbar"><div class="mode-switch" role="group" aria-label="Game mode"><button id="daily-tab" class="active" aria-pressed="true"><i data-lucide="trophy"></i>Daily matchday</button><button id="practice-tab" aria-pressed="false"><i data-lucide="flag"></i>Training ground</button></div><span class="round-edition"><i data-lucide="calendar-days"></i><span class="round-date"><span id="round-number"></span><span id="round-date">Daily challenge</span></span><span class="edition-divider" aria-hidden="true"></span><span class="edition-tag">5 CLUES · ONE BEAUTIFUL GAME</span></span></div><div class="header-actions"><button id="sound-button" class="sound-button" aria-label="Mute sounds" aria-pressed="false"><span class="sound-on"><i data-lucide="volume-2"></i></span><span class="sound-off"><i data-lucide="volume-x"></i></span></button><button id="stats-button" aria-label="Your stats"><i data-lucide="chart-no-axes-column-increasing"></i><span class="button-text">My stats</span></button><button id="help-button" aria-label="How to play"><i data-lucide="circle-help"></i><span class="button-text">How to play</span></button></div></header>
<main class="multisteps_form">
<div class="game-board">
<div class="match-header">
<div class="scoreboard"><Pitch/><span class="score-label">MATCH POINTS</span><strong id="total">0</strong><span class="score-cap">OUT OF 5,000</span></div>
<section class="multisteps_form_panel" id="question-panel" aria-label="Current question"><div class="question-topline"><div class="question-meta"><span class="question_number" id="q-number">QUESTION 1 / 5</span><span id="sport">Football</span><span class="meta-dot">/</span><span id="year">World tour</span></div><div class="progress-track" id="steps" aria-label="Round progress">{[1,2,3,4,5].map(n=><span class:list={['step',{current:n===1}]} aria-label={`Question ${n}`}><svg viewBox="0 0 36 38" aria-hidden="true"><path d="M11 3L2 9l4 9 5-2v19h14V16l5 2 4-9-9-6c-1 6-13 6-14 0Z"/></svg><span>{String(n).padStart(2,'0')}</span></span>)}</div></div><h2 id="question" tabindex="-1">Where did football history happen?</h2><p class="question-helper" id="question-helper">From legendary grounds to World Cup glory. Place your pin.</p><p id="hint" class="hint" hidden></p></section>
</div>
<div class="field-area"><WorldMap/>
<div id="reveal" class="reveal" hidden role="status"><div class="reveal-summary"><div><span class="result-eyebrow" id="result-kicker">THE MOMENT, MAPPED</span><h2 id="answer-city"></h2></div><div class="result-numbers"><strong id="round-points"></strong><span id="distance"></span></div></div><p id="answer-fact"></p></div></div>
<div class="guess-actions"><div class="pin-state"><span class="pin-state-icon"><i data-lucide="map-pin"></i></span><span id="pin-status" role="status">Choose a spot on the map</span></div><div class="action-buttons"><button id="hint-button" class="assist-button"><i data-lucide="lightbulb"></i><span class="assist-long">Need an assist?</span><span class="assist-short">Assist</span><small>−200 max</small></button><button id="submit" class="next_btn" disabled><span id="submit-label">Confirm guess</span><i data-lucide="arrow-right"></i></button></div></div>
</div>
<div class="round-extras"><label class="confirm-toggle"><input type="checkbox" id="confirm-toggle"/><span>Confirm before locking in</span></label><span id="round-note">Same five questions for everyone · Resets at 00:00 UTC</span><button id="new-practice" hidden><i data-lucide="rotate-ccw"></i>New training session</button></div>
<noscript><p class="noscript-note">Please enable JavaScript to play the interactive map game.</p></noscript>
</main>
<section class="seo-intro" aria-labelledby="intro-title">
<h2 id="intro-title">The daily football geography quiz</h2>
<Byline path="/"/>
<p>Geo Football gives you five football clues every day. Each one points to a real place: a famous stadium, the town where a legend was born, or the ground where a World Cup or Champions League final was decided. Drop your pin on the world map and score up to 1,000 points for each question, depending on how close you land.</p>
<ul class="intro-points">
<li><strong>{total} questions, {nations} countries.</strong> Stadiums past and present, birthplaces of men’s and women’s football legends, and the stories behind famous matches.</li>
<li><strong>New every day, never repeated within a year.</strong> Everyone plays the same matchday, which resets at 00:00 UTC. No question comes back for 395 days.</li>
<li><strong>Free, with no account.</strong> Build a streak, share a spoiler-free score with friends, or practise without limits on the training ground.</li>
</ul>
<h2 id="faq-title" class="intro-faq-title">Frequently asked questions</h2>
<div class="faq">{homeFaq.map(([q, a]) => <><h3>{q}</h3><p>{a}</p></>)}</div>
<p class="intro-links"><a href="/how-to-play/">How to play and scoring</a><a href="/about/">About the questions</a></p>
</section>
<footer class="site-footer"><span>BUILT FOR THE BEAUTIFUL GAME</span><nav class="footer-links" aria-label="More about Geo Football"><a href="/how-to-play/">How to play</a><a href="/about/">About</a><a href="/data-licenses.txt">Data credits</a></nav><span>Five chances. Make them count.</span></footer>
<dialog id="help-dialog" aria-labelledby="help-title"><button class="dialog-close" data-close="help-dialog" aria-label="Close instructions"><i data-lucide="x"></i></button><span class="eyebrow">HOW TO PLAY</span><h2 id="help-title">Put your football knowledge<br/>on the map.</h2><ol><li><b>1</b><div><strong>Read the clue</strong><p>Each question points to a real place in football history.</p></div></li><li><b>2</b><div><strong>Drop your pin</strong><p>Drag to move the map. Use +/− or pinch to zoom. Move your pin as often as you like before confirming.</p></div></li><li><b>3</b><div><strong>See how close you got</strong><p>Within 10 km earns 1,000 points. Your score decreases with distance. Using a hint caps that question at 800 points.</p></div></li></ol><p class="dialog-note">A new daily set at midnight UTC. From 29 September 2026, our {questions.length.toLocaleString('en-US')}-question rotation keeps daily repeats {DAILY_REPEAT_DAYS} days apart. Training prioritises questions you haven’t seen in this browser. Some ground clues use historical stadium names; aim for the stadium site. Progress and stats are saved in this browser, with no account needed.</p><p class="dialog-credits">Stadium data: WorldSoccerStadiums. Birthplace pins: <a href="https://www.geonames.org/" target="_blank" rel="noreferrer">GeoNames</a> (CC BY 4.0). Map: Natural Earth. <a href="/data-licenses.txt" target="_blank">Full data credits</a></p><button class="next_btn full" data-close="help-dialog">Let’s play <i data-lucide="arrow-right"></i></button></dialog>
<dialog id="results-dialog" aria-labelledby="finish-title"><button class="dialog-close" data-close="results-dialog" aria-label="Close results"><i data-lucide="x"></i></button><div class="results-pitch"><Pitch/><div class="medal"><i data-lucide="trophy"></i></div></div><span class="eyebrow" id="finish-mode">DAILY ROUND COMPLETE</span><h2 id="finish-title">Full-time. Well played.</h2><div class="final-score"><strong id="finish-score">0</strong><span>out of 5,000 points</span></div><p id="finish-streak" class="finish-streak" hidden></p><div id="round-results" class="result-bars" aria-label="Question-by-question results"></div><Sharing/><button id="play-again" class="secondary-button">Play a practice round <i data-lucide="arrow-right"></i></button><p class="dialog-note" id="next-round-note"></p></dialog>
<dialog id="stats-dialog" aria-labelledby="stats-title"><button class="dialog-close" data-close="stats-dialog" aria-label="Close stats"><i data-lucide="x"></i></button><span class="eyebrow">YOUR DAILY ROUNDS</span><h2 id="stats-title">A little better, every day.</h2><div class="stats-grid"><div><strong id="stat-played">0</strong><span>Played</span></div><div class="streak-tile"><strong id="stat-streak">0</strong><span>Current streak</span></div><div><strong id="stat-best-streak">0</strong><span>Best streak</span></div><div class="wide"><strong id="stat-best">0</strong><span>Best score</span></div><div class="wide"><strong id="stat-average">0</strong><span>Average</span></div></div><p class="dialog-note">Saved on this browser only. Practice rounds don’t count toward these stats.</p><button class="next_btn full" data-close="stats-dialog">Back to the map <i data-lucide="arrow-right"></i></button></dialog>
<dialog id="switch-dialog" aria-labelledby="switch-title"><h2 id="switch-title">Start a new practice round?</h2><p class="dialog-note">Your current practice round will be replaced. Daily progress stays saved.</p><div class="dialog-buttons"><button class="secondary-button" data-close="switch-dialog">Keep playing</button><button id="confirm-practice" class="next_btn">New round</button></div></dialog>
<div id="toast" class="toast" role="status" hidden></div>
<script src="../app.js"></script>
</body></html>
