---
import {questions} from '../data/questions.js';
import {DAILY_REPEAT_DAYS} from '../lib/game.js';
import Sharing from '../components/Sharing.astro';
import Pitch from '../components/Pitch.astro';
import WorldMap from '../components/WorldMap.astro';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '../styles/quizo-adapted.css';
import '../styles/global.css';
import '../styles/football-theme.css';
import '../styles/sharing.css';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#06101a"/><meta name="description" content="Five football clues. One world map. Play a daily football geography challenge with Geo Football."/><title>Geo Football — Daily football geography</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head>
<body>
<header class="site-header"><a class="brand" href="/" aria-label="Geo Football home"><span class="brand-mark"><img src="/favicon.svg" alt="" width="40" height="45"/></span><span class="brand-type">GEO<span>FOOTBALL</span></span></a><span class="header-tagline">THE WORLD IS YOUR HOME GROUND</span><div class="round-toolbar"><div class="mode-switch" role="group" aria-label="Game mode"><button id="daily-tab" class="active" aria-pressed="true"><i data-lucide="trophy"></i>Daily matchday</button><button id="practice-tab" aria-pressed="false"><i data-lucide="flag"></i>Training ground</button></div><span class="round-edition"><i data-lucide="calendar-days"></i><span id="round-date" class="round-date">Daily challenge</span><span class="edition-divider" aria-hidden="true"></span><span class="edition-tag">5 CLUES · ONE BEAUTIFUL GAME</span></span></div><div class="header-actions"><button id="stats-button" aria-label="Your stats"><i data-lucide="chart-no-axes-column-increasing"></i><span>My stats</span></button><button id="help-button" aria-label="How to play"><i data-lucide="circle-help"></i><span>How to play</span></button></div></header>
<main class="multisteps_form">
<div class="game-board">
<div class="match-header">
<div class="scoreboard"><Pitch/><span class="score-label">MATCH POINTS</span><strong id="total">0</strong><span class="score-cap">OUT OF 5,000</span></div>
<section class="multisteps_form_panel" id="question-panel" aria-label="Current question"><div class="question-topline"><div class="question-meta"><span class="question_number" id="q-number">QUESTION 1 / 5</span><span id="sport">Football</span><span class="meta-dot">/</span><span id="year">World tour</span></div><div class="progress-track" id="steps" aria-label="Round progress">{[1,2,3,4,5].map(n=><span class:list={['step',{current:n===1}]} aria-label={`Question ${n}`}><svg viewBox="0 0 36 38" aria-hidden="true"><path d="M11 3L2 9l4 9 5-2v19h14V16l5 2 4-9-9-6c-1 6-13 6-14 0Z"/></svg><span>{String(n).padStart(2,'0')}</span></span>)}</div></div><h1 id="question" tabindex="-1">Where did football history happen?</h1><p class="question-helper" id="question-helper">From legendary grounds to World Cup glory. Place your pin.</p><p id="hint" class="hint" hidden></p></section>
</div>
<div class="field-area"><WorldMap/>
<div id="reveal" class="reveal" hidden role="status"><div class="reveal-summary"><div><span class="result-eyebrow" id="result-kicker">THE MOMENT, MAPPED</span><h2 id="answer-city"></h2></div><div class="result-numbers"><strong id="round-points"></strong><span id="distance"></span></div></div><p id="answer-fact"></p></div></div>
<div class="guess-actions"><div class="pin-state"><span class="pin-state-icon"><i data-lucide="map-pin"></i></span><span id="pin-status" role="status">Choose a spot on the map</span></div><div class="action-buttons"><button id="hint-button" class="assist-button"><i data-lucide="lightbulb"></i><span class="assist-long">Need an assist?</span><span class="assist-short">Assist</span><small>−200 max</small></button><button id="submit" class="next_btn" disabled><span id="submit-label">Confirm guess</span><i data-lucide="arrow-right"></i></button></div></div>
</div>
<div class="round-extras"><span id="round-note">Same five questions for everyone · Resets at 00:00 UTC</span><button id="new-practice" hidden><i data-lucide="rotate-ccw"></i>New training session</button></div>
<noscript><p class="noscript-note">Please enable JavaScript to play the interactive map game.</p></noscript>
</main>
<footer class="site-footer"><span>BUILT FOR THE BEAUTIFUL GAME</span><span class="footer-brand">GEO FOOTBALL</span><span>Five chances. Make them count.</span></footer>
<dialog id="help-dialog" aria-labelledby="help-title"><button class="dialog-close" data-close="help-dialog" aria-label="Close instructions"><i data-lucide="x"></i></button><span class="eyebrow">HOW TO PLAY</span><h2 id="help-title">Put your football knowledge<br/>on the map.</h2><ol><li><b>1</b><div><strong>Read the clue</strong><p>Each question points to a real place in football history.</p></div></li><li><b>2</b><div><strong>Drop your pin</strong><p>Drag to move the map. Use +/− or pinch to zoom. Move your pin as often as you like before confirming.</p></div></li><li><b>3</b><div><strong>See how close you got</strong><p>Within 10 km earns 1,000 points. Your score decreases with distance. Using a hint caps that question at 800 points.</p></div></li></ol><p class="dialog-note">A new daily set at midnight UTC. From 29 September 2026, our {questions.length}-question rotation keeps daily repeats {DAILY_REPEAT_DAYS} days apart. Training prioritises questions you haven’t seen in this browser. Some ground clues use historical stadium names; aim for the stadium site. Progress and stats are saved in this browser, with no account needed.</p><button class="next_btn full" data-close="help-dialog">Let’s play <i data-lucide="arrow-right"></i></button></dialog>
<dialog id="results-dialog" aria-labelledby="finish-title"><button class="dialog-close" data-close="results-dialog" aria-label="Close results"><i data-lucide="x"></i></button><div class="results-pitch"><Pitch/><div class="medal"><i data-lucide="trophy"></i></div></div><span class="eyebrow" id="finish-mode">DAILY ROUND COMPLETE</span><h2 id="finish-title">Full-time. Well played.</h2><div class="final-score"><strong id="finish-score">0</strong><span>out of 5,000 points</span></div><Sharing/><details class="results-details"><summary>View answer breakdown</summary><div id="round-results"></div></details><button id="play-again" class="secondary-button">Play a practice round <i data-lucide="arrow-right"></i></button><p class="dialog-note" id="next-round-note"></p></dialog>
<dialog id="stats-dialog" aria-labelledby="stats-title"><button class="dialog-close" data-close="stats-dialog" aria-label="Close stats"><i data-lucide="x"></i></button><span class="eyebrow">YOUR DAILY ROUNDS</span><h2 id="stats-title">A little better, every day.</h2><div class="stats-grid"><div><strong id="stat-played">0</strong><span>Played</span></div><div><strong id="stat-best">0</strong><span>Best score</span></div><div><strong id="stat-average">0</strong><span>Average</span></div></div><p class="dialog-note">Saved on this browser only. Practice rounds don’t count toward these stats.</p><button class="next_btn full" data-close="stats-dialog">Back to the map <i data-lucide="arrow-right"></i></button></dialog>
<dialog id="switch-dialog" aria-labelledby="switch-title"><h2 id="switch-title">Start a new practice round?</h2><p class="dialog-note">Your current practice round will be replaced. Daily progress stays saved.</p><div class="dialog-buttons"><button class="secondary-button" data-close="switch-dialog">Keep playing</button><button id="confirm-practice" class="next_btn">New round</button></div></dialog>
<div id="toast" class="toast" role="status" hidden></div>
<script src="../app.js"></script>
</body></html>
