  "dependencies": {
    "astro": "^5.13.0",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "lucide": "^0.468.0",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/barlow-condensed": "^5.2.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
